# API base URL (baked into the PWA at build time via EXPO_PUBLIC_*)
#
# Local development:
#   http://localhost:8000
#
# Physical device on LAN (Expo Go):
#   run scripts/start-dev.ps1 or set manually, e.g. http://192.168.1.42:8000
#
# Production PWA build (HTTPS required for install prompt + geolocation):
#   EXPO_PUBLIC_API_URL=https://api.your-domain.com npm run build:web
EXPO_PUBLIC_API_URL=http://localhost:8000

# Set automatically by start-dev scripts for Expo Go on a phone (same Wi-Fi as this PC)
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.42
