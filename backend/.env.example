DJANGO_SECRET_KEY=dev-only-replace-with-at-least-32-random-characters
DJANGO_SETTINGS_MODULE=config.settings.development
MAP_BOX_TOKEN=pk.your_mapbox_public_token

# --- Production (Render) — use config.settings.production ---
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_ALLOWED_HOSTS=your-service.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# DATABASE_URL=postgres://...   (from Render Postgres add-on)
# REDIS_URL=redis://...         (optional — live complaint WebSocket updates)
# OTP_MOCK_MODE=false

# Production PWA — comma-separated origins (no trailing slashes), e.g.:
# CORS_ALLOWED_ORIGINS=https://app.dawasa.example,https://www.dawasa.example

# SQLite (default) — no extra config. Data file: backend/db.sqlite3

# MySQL — USE_MYSQL=true is set automatically by scripts/sqlite_to_mysql.py
USE_MYSQL=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=dawasa_water_quality
MYSQL_USER=root
MYSQL_PASSWORD=123456789
